!models/STLfile-large/**/*.exported.txt
!models/STLfile-large/**/readme.md

# Customer test models that must not be published. The test configs list
# private_models\models\<fixture>\ as an Optional second location for every fixture, so a machine
# without this folder simply finds nothing there. Give it its own private git remote and clone it
# to mx_testing\private_models\ - see the readme.md in that folder.
private_models/
