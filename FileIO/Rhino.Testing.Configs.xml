<?xml version="1.0" encoding="utf-8"?>
<Settings>
  <RhinoSystemDirectory>C:\Program Files\Rhino 9 WIP\System\</RhinoSystemDirectory>
  <!-- Uncomment line below and set to system path of Rhino to test (overrides value set above) -->
  <!--<RhinoSystemDirectory>C:\dev\github\mcneel\rhino\src4\bin\Release\</RhinoSystemDirectory>-->

  <LoadGrasshopper>false</LoadGrasshopper>

  <Enabled>true</Enabled>

  <!-- Locations are relative to this file as it sits next to the test assembly, i.e.
       FileIO\bin\<Configuration>\<TargetFramework>\, so four levels up is the repository root. -->
  <ModelDirectories>

    <!-- ===== STEP ===== -->

    <ModelDirectory Fixture="StepImport" Location="..\..\..\..\models\STEPfile\" Enabled="true" />
    <ModelDirectory Fixture="StepImport" Location="..\..\..\..\private_models\models\STEPfile\" Optional="true" Enabled="true" />

    <!-- StepImportFuture is [Explicit]: models that do not import correctly yet, run on purpose. -->
    <ModelDirectory Fixture="StepImportFuture" Location="..\..\..\..\models\STEPfile-future\" Enabled="true" />
    <ModelDirectory Fixture="StepImportFuture" Location="..\..\..\..\private_models\models\STEPfile-future\" Optional="true" Enabled="true" />

    <!-- StepImportLarge is [Explicit] too. The models are hundreds of megabytes each and are not
         committed, so both locations are optional. -->
    <ModelDirectory Fixture="StepImportLarge" Location="..\..\..\..\models\STEPfile-large\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="StepImportLarge" Location="..\..\..\..\private_models\models\STEPfile-large\" Optional="true" Enabled="true" />

    <!-- StepExport round trips a model out through the STEP writer and back in. It reuses the
         import corpus - a file worth guarding on the way in is worth guarding on the way out -
         and adds models\STEPfile-export\ for .3dm sources, the only way to put Rhino-native
         geometry through the writer. -->
    <ModelDirectory Fixture="StepExport" Location="..\..\..\..\models\STEPfile\" Enabled="true" />
    <ModelDirectory Fixture="StepExport" Location="..\..\..\..\models\STEPfile-export\" Enabled="true" />
    <ModelDirectory Fixture="StepExport" Location="..\..\..\..\private_models\models\STEPfile\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="StepExport" Location="..\..\..\..\private_models\models\STEPfile-export\" Optional="true" Enabled="true" />

    <!-- StepExportFuture is [Explicit]: models that do not survive the round trip yet. -->
    <ModelDirectory Fixture="StepExportFuture" Location="..\..\..\..\models\STEPfile-export-future\" Enabled="true" />
    <ModelDirectory Fixture="StepExportFuture" Location="..\..\..\..\private_models\models\STEPfile-export-future\" Optional="true" Enabled="true" />

    <!-- StepExportLarge is [Explicit] too, and costs an import, an export and a second import per
         model. Same uncommitted assemblies as StepImportLarge, so both locations are optional. -->
    <ModelDirectory Fixture="StepExportLarge" Location="..\..\..\..\models\STEPfile-large\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="StepExportLarge" Location="..\..\..\..\private_models\models\STEPfile-large\" Optional="true" Enabled="true" />

    <!-- ===== IGES ===== -->

    <ModelDirectory Fixture="IgesImport" Location="..\..\..\..\models\IGESfile\" Enabled="true" />
    <ModelDirectory Fixture="IgesImport" Location="..\..\..\..\private_models\models\IGESfile\" Optional="true" Enabled="true" />

    <!-- IgesImportFuture is [Explicit]: models that do not import correctly yet, run on purpose. -->
    <ModelDirectory Fixture="IgesImportFuture" Location="..\..\..\..\models\IGESfile-future\" Enabled="true" />
    <ModelDirectory Fixture="IgesImportFuture" Location="..\..\..\..\private_models\models\IGESfile-future\" Optional="true" Enabled="true" />

    <!-- IgesImportLarge is [Explicit] too. The models are not committed, so both locations are optional. -->
    <ModelDirectory Fixture="IgesImportLarge" Location="..\..\..\..\models\IGESfile-large\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="IgesImportLarge" Location="..\..\..\..\private_models\models\IGESfile-large\" Optional="true" Enabled="true" />

    <!-- IgesExport round trips a model out through the IGES writer and back in. It reuses the
         import corpus and adds models\IGESfile-export\ for .3dm sources, the only way to put
         Rhino-native geometry through the writer. -->
    <ModelDirectory Fixture="IgesExport" Location="..\..\..\..\models\IGESfile\" Enabled="true" />
    <ModelDirectory Fixture="IgesExport" Location="..\..\..\..\models\IGESfile-export\" Enabled="true" />
    <ModelDirectory Fixture="IgesExport" Location="..\..\..\..\private_models\models\IGESfile\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="IgesExport" Location="..\..\..\..\private_models\models\IGESfile-export\" Optional="true" Enabled="true" />

    <!-- IgesExportFuture is [Explicit]: models that do not survive the round trip yet. -->
    <ModelDirectory Fixture="IgesExportFuture" Location="..\..\..\..\models\IGESfile-export-future\" Enabled="true" />
    <ModelDirectory Fixture="IgesExportFuture" Location="..\..\..\..\private_models\models\IGESfile-export-future\" Optional="true" Enabled="true" />

    <!-- IgesExportLarge is [Explicit] too, and costs an import, an export and a second import per
         model. Same uncommitted files as IgesImportLarge, so both locations are optional. -->
    <ModelDirectory Fixture="IgesExportLarge" Location="..\..\..\..\models\IGESfile-large\" Optional="true" Enabled="true" />
    <ModelDirectory Fixture="IgesExportLarge" Location="..\..\..\..\private_models\models\IGESfile-large\" Optional="true" Enabled="true" />

  </ModelDirectories>

</Settings>
