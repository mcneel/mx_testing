# STEP test assemblies: hundreds of megabytes each, kept on disk but never committed.
# Their .expected.txt baselines are tiny and are committed.
# The folder is scanned with AllDirectories, so the models may be grouped in subfolders the way
# models/STEPfile/AP214/ is. That is why this excludes recursively and then re-admits the
# subfolders: a plain "models/STEPfile-large/*" stops git descending into them, and the
# re-inclusions below never get a chance to match.
models/STEPfile-large/**
!models/STEPfile-large/**/
!models/STEPfile-large/**/*.expected.txt
!models/STEPfile-large/**/*.exported.txt
!models/STEPfile-large/**/readme.md

# IGES large models: same arrangement as STEPfile-large above.
models/IGESfile-large/**
!models/IGESfile-large/**/
!models/IGESfile-large/**/*.expected.txt
!models/IGESfile-large/**/*.exported.txt
!models/IGESfile-large/**/readme.md

# DXF large models: same arrangement as STEPfile-large above.
models/DXFfile-large/**
!models/DXFfile-large/**/
!models/DXFfile-large/**/*.expected.txt
!models/DXFfile-large/**/*.exported.txt
!models/DXFfile-large/**/readme.md

# DWG large models: same arrangement as STEPfile-large above.
models/DWGfile-large/**
!models/DWGfile-large/**/
!models/DWGfile-large/**/*.expected.txt
!models/DWGfile-large/**/*.exported.txt
!models/DWGfile-large/**/readme.md

# OBJ large models: same arrangement as STEPfile-large above.
models/OBJfile-large/**
!models/OBJfile-large/**/
!models/OBJfile-large/**/*.expected.txt
!models/OBJfile-large/**/*.exported.txt
!models/OBJfile-large/**/readme.md

# STL large models: same arrangement as STEPfile-large above.
